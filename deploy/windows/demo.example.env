# ==============================================================================
# CẤU HÌNH MẪU CHO BẢN PHÁT HÀNH WINDOWS PORTABLE DEMO (AI CARE ASSISTANT)
# ==============================================================================
# Bản sao này được dùng để tạo runtime\.env trong lần thiết lập đầu tiên (Setup.cmd).
# Sau khi khởi tạo, runtime\.env được bảo toàn và không bị ghi đè.

# 1. Chế độ Hoạt động & Mạng
DEMO_LOCAL=1
PORTABLE_MODE=1
WEB_HOST=127.0.0.1
WEB_PORT=8080

# 2. Camera & Hiển thị
CAMERA_INDEX=0
FRAME_WIDTH=640
FRAME_HEIGHT=480
FPS_TARGET=30

# 3. Trợ lý Giọng nói Tiếng Việt Cục bộ (Zipformer INT8 + Local Rules)
# Chạy 100% offline trên CPU, không cần bất kỳ API key nào
VOICE_AI_ENABLED=true
VOICE_MODEL_PATH=data/models/sherpa-onnx-zipformer-vi-30M-int8-2026-02-09
VOICE_DEVICE=cpu
VOICE_COMPUTE_TYPE=int8
VOICE_CPU_THREADS=2
VOICE_MAX_SECONDS=15
VOICE_BEAM_SIZE=1
VOICE_SEMANTIC_BACKEND=local_rules

# 4. Dịch vụ Thông báo Email (Tùy chọn)
# Mặc định tắt để hoạt động offline hoàn toàn. Khi tắt, hệ thống ghi nhận trạng thái
# "Mô phỏng / Chưa gửi" và không làm gián đoạn trải nghiệm người dùng.
EMAIL_ENABLED=false
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
MEDICATION_CATCHUP_MINUTES=60
MEDICATION_ALERT_LIMIT=3

