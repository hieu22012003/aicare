# Backend only: keep this file/secret store outside the elder desktop distribution.
GEMINI_API_KEY=
GEMINI_INTENT_ENABLED=false
# Set true only after checking AI Studio project's Free tier and no billing.
GEMINI_FREE_TIER_VERIFIED=false
GEMINI_PROJECT_ID=
GEMINI_INTENT_MODEL=gemini-3.5-flash-lite
GEMINI_INTENT_TIMEOUT_SECONDS=8
# Conservative local caps, not claims about Google's quota. Lower to project's limits.
GEMINI_INTENT_RPM_CAP=1
GEMINI_INTENT_RPD_CAP=10
GEMINI_INTENT_DAILY_RESERVE=2
GEMINI_INTENT_RETRIES=0
GEMINI_INTENT_QUOTA_PATH=runtime/gemini-intent-quota.json
# Conservative local token reservation cap, not a provider quota assertion.
GEMINI_INTENT_TPM_CAP=2400
