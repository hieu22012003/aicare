# Cấu hình Camera và Hệ thống
CAMERA_INDEX=0
FRAME_WIDTH=640
FRAME_HEIGHT=480
FPS_TARGET=30

# Cấu hình Dịch Vụ Cảnh Báo Gmail (SMTP)
# Đặt EMAIL_ENABLED=true khi muốn bật tính năng gửi email cảnh báo tự động
EMAIL_ENABLED=false
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
# Tài khoản Gmail gửi cảnh báo của hệ thống (phải bật 2FA và tạo Mật khẩu ứng dụng 16 ký tự)
EMAIL_USERNAME=contact-c4e30822@example.com
EMAIL_PASSWORD=your_16_character_app_password
# Medication reminders: old alerts suppressed after downtime beyond this age.
MEDICATION_CATCHUP_MINUTES=60
# Maximum SMTP attempts per rolling hour (all patients).
MEDICATION_ALERT_LIMIT=3

# Local STT: true = chuẩn bị worker khi mở app; false = chỉ chuẩn bị khi nhấn nút micro.
VOICE_AI_ENABLED=false
VOICE_MODEL_PATH=data/models/sherpa-onnx-zipformer-vi-30M-int8-2026-02-09
VOICE_DEVICE=cpu
VOICE_COMPUTE_TYPE=int8
VOICE_CPU_THREADS=4
VOICE_MAX_SECONDS=30
VOICE_BEAM_SIZE=1
# Không cần API STT key hoặc model text/LLM.

# Text intent client only. Provider secret belongs to a separate backend environment.
VOICE_INTENT_ENABLED=false
VOICE_INTENT_BACKEND_URL=http://127.0.0.1:8080
# Existing web auth session token (never a Gemini API key).
VOICE_INTENT_SESSION_TOKEN=

# Semantic routing: local_rules runs without API key and never falls back to cloud.
VOICE_SEMANTIC_BACKEND=local_rules

# Optional reviewed JSON rule configuration; unset uses bundled version 1.
# VOICE_RULES_PATH=/absolute/path/to/rules.json

# --- Kết nối app tại nhà với web trên Render (chế độ thiết bị) ---
# Khi đặt cả hai biến, app desktop chỉ gửi toạ độ khung xương/bàn tay lên server (không gửi video);
# lịch thuốc, nhắc giờ và cảnh báo "chưa uống" do server quản lý và hiện trên web.
# AICARE_CLOUD_URL=https://aicare-xxxx.onrender.com
# AICARE_DEVICE_KEY=khoa-thiet-bi-dai-it-nhat-16-ky-tu
# AICARE_CLOUD_PATIENT_ID=patient_001
